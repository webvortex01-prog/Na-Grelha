{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/client/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/client/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/client/admin.html"
    },
    {
      "source": "/",
      "destination": "/client/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/client/$1"
    }
  ]
}

