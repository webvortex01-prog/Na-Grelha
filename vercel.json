{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/client/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/client/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/client/admin.html"
    },
    {
      "source": "/(.*)",
      "destination": "/client/$1"
    }
  ]
}
